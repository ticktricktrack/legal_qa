<div id="<%= dom_id question %>" class="card bg-base-100 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">
      <%= question.title %>
      <div class="badge badge-<%= badge_color(question) %>"><%= question.status %></div>
    </h2>

    <% unless my_question?(question) %>
      <p>Asked by: <%= question.user.email_address%></p>
    <% end %>

    <p><%= question.body %></p>
    <div class="card-actions justify-end">
      <%if question.answered? %>
        <%= link_to question_path(question) do %>
          <button class="btn btn-warning">Read Answer</button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
