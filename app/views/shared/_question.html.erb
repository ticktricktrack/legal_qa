<div id="<%= dom_id question %>" class="card bg-base-100 shadow-sm mt-5">
  <div class="card-body">
    <h2 class="card-title">
      <%= question.title %>
      <div class="badge badge-<%= badge_color(question) %>"><%= question.status %></div>
    </h2>

    <% unless my_question?(question) %>
      <p>Asked by: <%= question.user.email_address%></p>
    <% end %>

    <p><%= question.body %></p>
    <% if Current.user.user? %>
      <%= render partial: 'shared/user_buttons', locals: { question: question } %>
    <% end %>
    <% if Current.user.lawyer? %>
      <%= render partial: 'shared/lawyer_buttons', locals: { question: question } %>
    <% end %>
  </div>
</div>
