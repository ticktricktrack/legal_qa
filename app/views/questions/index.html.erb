<div class="container flex-col">
  <div
    tabindex="0"
    class="bg-base-200 collapse"
  >
    <div class="collapse-title font-semibold">Submit a new question</div>
    <div class="collapse-content text-sm">
      <turbo-frame id="new_question">
        <%= render "form", question: Question.new %>
      </turbo-frame>
    </div>
  </div>

  <%= turbo_stream_from "questions" %>
  <div id="questions-list">
    <%= render collection: @questions, partial: "shared/question" %>
  </div>
</div>
