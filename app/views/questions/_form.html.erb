<%= form_with(model: question) do |form| %>
  <% if question.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(question.errors.count, "error") %> prohibited this question from being saved:</h2>

      <ul>
        <% question.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="fieldset bg-base-200 border-base-300 rounded-box border p-4 w-3xl">
    <legend class="fieldset-legend">What's your question?</legend>
    <%= form.text_field :title, class: "input" %>
    <p class="label">Required</p>

    <legend class="fieldset-legend">Please describe the issue in detail</legend>
    <%= form.text_area :body, placeholder: "Description", class: "textarea" %>
    <p class="label">Required</p>

    <div>
      <%= form.submit class: "btn btn-primary" %>
    </div>
  </fieldset>
<% end %>
